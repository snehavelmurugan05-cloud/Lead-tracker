# =========================================================================
# FRONTEND CONFIGURATION
# Copy these into `.env` or `.env.local` inside the root directory.
# =========================================================================
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-content...

# =========================================================================
# BACKEND SUPABASE SECRETS
# Set these inside your Supabase project Dashboard (Settings > API > Secrets)
# or via the Supabase CLI (`supabase secrets set KEY=VALUE`).
# =========================================================================
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-content...
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ12345...
TELEGRAM_CHAT_ID=-1002345678901
